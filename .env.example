# Keep paid gating off until the entitlement migration is deployed and a
# trusted billing webhook is maintaining each account's premium status.
VITE_SUBSCRIPTIONS_ENABLED=false
VITE_AUTH_ENABLED=false
# Keep checkout off until the RevenueCat/Paddle provider, Edge Functions and
# signed webhooks have been configured and tested for this environment.
VITE_CHECKOUT_ENABLED=false

# Public RevenueCat Web Purchase Link base URL only, without a user ID, query,
# or trailing path. Example: https://pay.rev.cat/generatedToken
VITE_REVENUECAT_PURCHASE_URL=

# Safe browser-side Supabase values. Never put a secret/service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set this to the final public origin before deployment, without a trailing path.
# Example: https://kural.example.com
VITE_SITE_URL=
