VITE_SUBSCRIPTIONS_ENABLED=false
VITE_AUTH_ENABLED=false
VITE_CHECKOUT_ENABLED=false

# Safe browser-side Supabase values. Never put a secret/service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set this to the final public origin before deployment, without a trailing path.
# Example: https://kural.example.com
VITE_SITE_URL=
