# Copy to supabase/.env.billing.live and fill it locally for production.
# Apply with: npx supabase secrets set --env-file supabase/.env.billing.live
# Never commit the filled file or paste its values into chat.

APP_ALLOWED_ORIGINS=https://kural.abirami.app,http://localhost:8080,http://127.0.0.1:8080
REVENUECAT_API_KEY=
REVENUECAT_ALLOWED_ENVIRONMENTS=PRODUCTION
REVENUECAT_MONTHLY_PRODUCT_ID=
REVENUECAT_YEARLY_PRODUCT_ID=
REVENUECAT_LIFETIME_PRODUCT_ID=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_HMAC_SECRET=
